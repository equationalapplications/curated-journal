/fixtures/seed-*
.superpowers/

# local signing credentials — EAS keystore bundle, upload keystore (keystore.jks),
# and keystore.properties that wires release signing; NEVER committed.
# Missing credentials/ = release builds refuse to sign (guard plugin); see docs/VERSIONING.md
/credentials/
